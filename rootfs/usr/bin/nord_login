#!/usr/bin/with-contenv bash

if ! iptables -L > /dev/null 2>&1; then
  echo "FATAL: iptables is not functional. Ensure your container config adds --cap-add=NET_ADMIN,NET_RAW" 1>&2
  # Null route rather than leaving traffic unprotected.
  ip route del default
  ip route del 0.0.0.0/1 > /dev/null 2>&1
  ip route add default via 127.0.0.1
  echo "--- Due to errors, routing has been disabled ---" 1>&2
  # Don't allow execution to proceed as traffic may not be protected. Don't exit either as
  # containers that expect to be behind the VPN will route through the normal network.
  while true; do
    sleep 3600
  done
fi

while [ ! -S /run/nordvpn/nordvpnd.sock ] ; do
  sleep 1
done

[[ -z "${TOKEN}" ]] && [[ -f "${TOKENFILE}" ]] && TOKEN="$(head -n 1 "${TOKENFILE}")"
# nordvpn >= 4.x asks for analytics consent on first use and loops forever without a tty
nordvpn set analytics off > /dev/null
# iptables policies are ACCEPT, so the kill switch is the only thing blocking traffic outside the vpn;
# enable it before login so there is no unprotected window while connecting
nordvpn set killswitch ${KILLSWITCH:-on}

if [[ -z ${TOKEN} ]]; then
  echo "No token set."
  exit 1
fi

# logout wipes the device key, which registers a new meshnet device on every start until the
# account device limit is reached, so keep the session unless the token changed
token_hash_file=/var/lib/nordvpn/token.sha256
token_hash=$(echo -n "${TOKEN}" | sha256sum | cut -d' ' -f1)
logged_in=""
if [[ "$(cat "${token_hash_file}" 2>/dev/null)" == "${token_hash}" ]]; then
  # a false negative costs a meshnet device, so give the daemon a few chances to load the session
  for i in 1 2 3; do
    nordvpn account > /dev/null 2>&1 && logged_in=1 && break
    sleep 2
  done
fi
if [[ -n ${logged_in} ]]; then
  echo "Already logged in."
else
  nordvpn logout > /dev/null
  nordvpn login --token "${TOKEN}" || {
    echo "Invalid token."
    exit 1
  }
  (umask 077; echo "${token_hash}" > "${token_hash_file}")
fi

exit 0
