#!/usr/bin/with-contenv bash

# Since nordvpn 6.x "technology" and "protocol" were merged into a single "protocol" setting
shopt -s nocasematch
case "${TECHNOLOGY:-NordLynx}" in
  OpenVPN) case "${PROTOCOL:-udp}" in tcp) protocol=openvpn_tcp ;; *) protocol=openvpn_udp ;; esac ;;
  NordWhisper) protocol=nordwhisper ;;
  *) protocol=nordlynx ;;
esac
shopt -u nocasematch
nordvpn set protocol ${protocol}

[[ -n ${DNS} ]] && nordvpn set dns ${DNS//[;,]/ }

[[ -n ${CYBER_SEC} ]] && nordvpn set protection ${CYBER_SEC}
[[ -n ${OBFUSCATE} ]] && echo "OBFUSCATE is no longer supported by nordvpn, use CONNECT=Obfuscated_Servers instead."
[[ -n ${FIREWALL} ]] && nordvpn set firewall ${FIREWALL}
[[ -n ${LAN_DISCOVERY} ]] && nordvpn set lan-discovery ${LAN_DISCOVERY}

# Configue local network and routing allow list
if [[ -n ${MESHNET} ]]; then
  echo "Meshing..."
  current_sleep=1
  # meshnet stays enabled across restarts, only turn it on when it is not
  until nordvpn settings | grep -q "Meshnet: enabled" || nordvpn set meshnet on; do
    if [ ${current_sleep} -gt 4096 ]; then
      echo "Unable to mesh."
      exit 1
    fi
    echo "Unable to mesh retrying in ${current_sleep} seconds."
    sleep ${current_sleep}
    current_sleep=$((current_sleep * 2))
  done
fi

# Configue local network and routing allow list
if [[ -n ${MESHNET} ]]; then
  # Falls back to ALLOWROUTE for setups that relied on it granting local access too
  allowedLocalHosts=${ALLOWLOCAL:-${ALLOWROUTE}}
  if [[ -n ${allowedLocalHosts} ]]; then
    IFS=',' read -ra allowed <<< "$allowedLocalHosts"
    for host in "${allowed[@]}"; do
      nordvpn meshnet peer local allow "${host}"
    done
  fi

  allowedRoutingHosts=${ALLOWROUTE}
  if [[ -n ${allowedRoutingHosts} ]]; then
    IFS=',' read -ra allowed <<< "$allowedRoutingHosts"
    for host in "${allowed[@]}"; do
      nordvpn meshnet peer routing allow "${host}"
    done
  fi
fi

[[ -n ${PORTS} ]] && for port in ${PORTS//[;,]/ }; do nordvpn allowlist add port "${port}"; done
[[ -n ${PORT_RANGE} ]] && nordvpn allowlist add ports ${PORT_RANGE}

docker_networks=$(dockerNetworks)
if [[ -n ${docker_networks} ]]; then
  IFS=',' read -ra networks <<< "$docker_networks"
  for net in "${networks[@]}"; do
    network=($net)
    nordvpn allowlist add subnet "${network[1]}"
  done
fi
[[ -n ${NETWORK} && -z ${NET_LOCAL} ]] && NET_LOCAL=${NETWORK}
[[ -n ${NET_LOCAL} ]] && for net in ${NET_LOCAL//[;,]/ }; do nordvpn allowlist add subnet "${net}"; done

exit 0
